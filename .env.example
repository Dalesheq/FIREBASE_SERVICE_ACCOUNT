# ==============================================================================
# ENVIRONMENT CONFIGURATION GUIDE
# ==============================================================================

# ==============================================================================
# 1. OPTIONAL LOCAL-DEVELOPMENT & AI STUDIO PREVIEW VARIABLES
# ==============================================================================
# In Google AI Studio preview and local development, all features run seamlessly
# without requiring manual entry of deployment variables:
# - API calls automatically use relative paths (/api/*) via the built-in server.
# - Firebase project identifiers automatically fall back to firebase-applet-config.json.
# - Supabase keys are optional in preview (only needed if actively testing photo uploads).

# GEMINI_API_KEY: Injected by AI Studio if AI features are used.
GEMINI_API_KEY=

# APP_URL: Injected by AI Studio container runtime.
APP_URL=

# SUPABASE_URL: (Optional in preview) Supabase project URL for private photo storage.
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: (Optional in preview) Server-only private storage key.
# CRITICAL: Keep server-side only. NEVER prefix with VITE_ or expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# 2. FIREBASE HOSTING BUILD VARIABLES (Configured in .env.production for Vite build)
# ==============================================================================
# Production frontend API URL pointing to the live Render backend service:
VITE_API_BASE_URL=https://sheq-inspection-app.onrender.com

# ==============================================================================
# 3. RENDER SERVER VARIABLES (Configured in Render Dashboard - NOT in AI Studio)
# ==============================================================================
# These variables belong strictly in your Render web service environment dashboard.
# Do NOT set them in AI Studio preview.
#
# PORT=10000 (Render automatically sets this)
# NODE_ENV=production
# FRONTEND_ORIGIN=https://gen-lang-client-0206733447.web.app
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
#
# Firebase identifiers (Render falls back to firebase-applet-config.json if omitted):
# FIREBASE_PROJECT_ID=gen-lang-client-0206733447
# FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-sheqinspectionma-4abefbf2-9ba0-4a2c-b1b2-e5df5e3a2729
# FIREBASE_API_KEY=
